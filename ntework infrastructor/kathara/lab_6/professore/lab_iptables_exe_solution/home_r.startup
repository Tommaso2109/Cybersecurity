
# NAT
iptables -t nat -A POSTROUTING -o eth1 -j MASQUERADE
iptables -A FORWARD -i eth1 -m state --state NEW -j DROP

#	Solution point 1.
#	Enable forwarding of SSH connections on port 22
#	Here the insert command -I is used instead of -A since otherwise the connection would be dropped by the rule at line 4 (the order of the rules matters)
iptables -I FORWARD -i eth1 -p tcp --dport 22 -j ACCEPT

#	Make incoming SSH connections to be redirected to "raspberry" node behind NAT on port 22
iptables -t nat -A PREROUTING -i eth1 -p tcp --dport 22 -j DNAT --to-destination 192.168.1.250:22


